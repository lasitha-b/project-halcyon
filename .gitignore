# Vagrant / VM state
.vagrant/
*.log

# Packer
packer/**/output-*/
packer/**/*.vmx
packer/**/packer_cache/
*.box

# Ansible
*.retry
ansible/.vault_pass
ansible/group_vars/secrets_seed.yml

# Generated per-deploy artifacts (contain live secrets — never commit)
docs/answer-key.md
ansible/generated/
ansible/inventory_discovered.yml

# ISOs (too large, and licensed media)
*.iso

# Terraform (AWS deployment path)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.tfplan

# Editor / OS
.DS_Store
*.swp
.obsidian/

# Python
__pycache__/
*.pyc
